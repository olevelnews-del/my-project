{
  "name": "hsc-academic-hub",
  "compatibility_date": "2026-11-25",
  "main": "./api/payment.js",
  "assets": {
    "directory": "./",
    "binding": "ASSETS",
    "run_worker_first": ["/api/*"]
  },
  "observability": {
    "enabled": true,
    "logs": {
      "enabled": true,
      "head_sampling_rate": 1
    },
    "traces": {
      "enabled": false
    }
  }
}
